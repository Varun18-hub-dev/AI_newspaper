# Local LLM Runtime Configuration (Ollama)
OLLAMA_BASE_URL=http://127.0.0.1:11434
MODEL_NAME=qwen2.5:3b

# Model Inference Parameters
TEMPERATURE=0.0
MAX_TOKENS=128
REQUEST_TIMEOUT=180.0

# Logging
LOG_LEVEL=INFO

# Phase 2 & 3 Ingestion & Selection Configuration (AI Domain)
AI_RSS_FEEDS=https://techcrunch.com/category/artificial-intelligence/feed/,https://theverge.com/rss/ai-artificial-intelligence/index.xml,https://huggingface.co/blog/feed.xml,https://feeds.arstechnica.com/arstechnica/technology-lab
MAX_ITEMS_PER_FEED=15
MAX_CLASSIFY_CANDIDATES=10
QWEN_MAX_CANDIDATES=10

# Phase 4 Clustering Configuration
CLUSTERING_SIMILARITY_THRESHOLD=0.45
CLUSTERING_TIME_WINDOW_HOURS=72.0
CLUSTERING_EMBEDDING_PROVIDER=tfidf

# Phase 5 Persistence & Deduplication Configuration
DB_PATH=data/newspaper.db
STORAGE_HISTORY_LOOKBACK_DAYS=7.0
ENABLE_STORAGE=true
MEANINGFUL_UPDATE_JACCARD_THRESHOLD=0.35
MEANINGFUL_UPDATE_TIME_THRESHOLD_HOURS=6.0

# Phase 6 Multi-Domain Configuration
ENABLED_DOMAINS=ai,technology,science,cybersecurity,business

# Phase 7 Daily Scheduling & Automation Configuration
SCHEDULE_ENABLED=true
SCHEDULE_TIME=06:00
SCHEDULE_TIMEZONE=Asia/Kolkata
SCHEDULE_LOCK_FILE=data/pipeline.lock
SCHEDULE_RUN_ON_STARTUP=false

